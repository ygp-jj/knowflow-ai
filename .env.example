# App
APP_NAME=KnowFlow AI
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://knowflow:knowflow_password@localhost:5432/knowflow_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=document_chunks

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowflow-documents
MINIO_SECURE=false

# LLM
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

# Embedding
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.your-embedding-provider.com
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
RAG_MAX_CONTEXT_CHARS=8000

# 文本切片（精准问答默认 256/50；对应 Settings.chunk_size / chunk_overlap）
CHUNK_SIZE=256
CHUNK_OVERLAP=50
# 标题独立成块：true=每个标题单独一个 chunk；false=标题可与后续段落合并（在 chunk_size 内）
CHUNK_TITLE_STANDALONE=true
