# 功能：提供前端本地开发和跨域部署时可选的 Vite 环境变量示例。

# 本地开发时一般不需要配置 VITE_API_BASE_URL，
# 前端会默认请求相对路径 /api/v1，并通过 Vite 代理转发到后端。
# 如果你的后端不在本机 8000 端口，可以修改 VITE_PROXY_TARGET。
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 当前后端与前端不在同域部署时，再显式指定 API 根地址。
# 例如：
# VITE_API_BASE_URL=http://10.17.223.59:8000
# VITE_API_BASE_URL=https://api.example.com

# 前端默认使用的 owner_id，便于本地联调和后续切换到登录态。
VITE_DEFAULT_OWNER_ID=101
